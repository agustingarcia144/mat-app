{
  "expo": {
    "name": "Mat Gestion",
    "slug": "mat-app",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mat-app",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.agusstingarcia144.matapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationsUsageDescription": "Mat te enviara recordatorios y avisos importantes sobre tus clases reservadas.",
        "NSCameraUsageDescription": "Mat necesita acceso a tu camara para escanear codigos QR de invitacion."
      },
      "icon": "./assets/app.icon",
      "associatedDomains": ["applinks:matgestion.app"]
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.agusstingarcia144.matapp",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "matgestion.app",
              "pathPrefix": "/join"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Mat necesita acceso a tu galería para subir comprobantes de pago.",
          "cameraPermission": "Mat necesita acceso a tu cámara para tomar fotos de comprobantes de pago."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Mat necesita acceso a tu camara para escanear codigos QR de invitacion."
        }
      ],
      "@react-native-community/datetimepicker",
      "@clerk/expo",
      "expo-font",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "mat-app"
        }
      ],
      "@sentry/react-native",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6989a53a-345c-43a7-9a11-74e15d9901bf"
      },
      "EXPO_PUBLIC_CLERK_GOOGLE_IOS_URL_SCHEME": "com.googleusercontent.apps.262169558391-8660larnefktthvsgp1e2bkq989i2gev"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6989a53a-345c-43a7-9a11-74e15d9901bf"
    }
  }
}
